{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "removeComments": false,
    "sourceMap": false,
    "outFile": "build/gptnotion.modular.js"
  },
  "files": [
    "src/ts/core/types.ts",
    "src/ts/core/errors.ts",
    "src/ts/core/events.ts",
    "src/ts/core/version.ts",
    "src/ts/contracts/models.ts",
    "src/ts/contracts/validators.ts",
    "src/ts/infrastructure/legacy-bridge.ts",
    "src/ts/infrastructure/mcp-client.ts",
    "src/ts/infrastructure/storage.ts",
    "src/ts/domain/page.ts",
    "src/ts/domain/block.ts",
    "src/ts/domain/link.ts",
    "src/ts/domain/database.ts",
    "src/ts/domain/settings.ts",
    "src/ts/features/editor.ts",
    "src/ts/features/rag.ts",
    "src/ts/features/ai.ts",
    "src/ts/features/agent.ts",
    "src/ts/features/search.ts",
    "src/ts/features/inbox.ts",
    "src/ts/features/export.ts",
    "src/ts/features/automation.ts",
    "src/ts/features/operator.ts",
    "src/ts/features/team.ts",
    "src/ts/ui/app-shell.ts",
    "src/ts/app/public-api.ts",
    "src/ts/app/bootstrap.ts"
  ]
}
